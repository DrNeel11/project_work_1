# Virtual environments (1.3GB+, platform-specific — never commit). venv_gpu
# holds a CUDA PyTorch build used only for local detector retraining.
drone-sim-today/venv/
drone-sim-today/venv_gpu/

# Scratch diagnostic stdout captures
drone-sim-today/diag_out*.txt
drone-sim-today/dev_run*.txt
drone-sim-today/gpu_install.txt
drone-sim-today/train_*.txt
drone-sim-today/sweep_*.txt

# Third-party library clone (installed via `pip install -e`, not our code —
# see README.md setup steps to reproduce)
drone-sim-today/gpd_src/

# Office lock files (exist only while a deck/document is open)
~$*

# Python
__pycache__/
*.pyc

# Regenerable raw capture frames (intermediate, not deliverables)
drone-sim-today/captures/

# gym-pybullet-drones default log output dir -- but keep our own
# experiments/evaluate.py deliverables (comparison.csv/.png) inside it
drone-sim-today/results/*
!drone-sim-today/results/comparison.csv
!drone-sim-today/results/comparison.png

# MBDD2025 dataset download + extracted/split copies (2.5GB+, real data --
# see README.md "Getting a trained model" for the download/prepare steps)
drone-sim-today/datasets/

# Base pretrained checkpoint auto-downloaded by ultralytics, and its own
# validation-run cache dir -- both regenerable, not our artifacts
drone-sim-today/yolo*.pt
drone-sim-today/runs/

# Redundant duplicate of best.pt from the last training epoch
drone-sim-today/weights/*/weights/last.pt

# Scratch dev-preview images from each module's own __main__ self-test
drone-sim-today/**/_*_preview/
drone-sim-today/**/_*_preview.png

# Local run logs (raw stdout captures kept for provenance during
# development; the distilled results are in RESULTS.md)
drone-sim-today/logs/
